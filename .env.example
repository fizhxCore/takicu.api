TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_owner_id_here

# Opsional tapi disarankan: string acak buat verifikasi kalau request webhook
# beneran dari Telegram. Isi bebas, lalu pakai nilai yang sama saat setWebhook.
TELEGRAM_WEBHOOK_SECRET=isi_dengan_string_acak_kamu

# Opsional — cuma dibutuhin buat fitur bikin/cabut API key lewat bot Telegram
# (/newkey, /listkeys, /revokekey). Kalau kosong, fitur ini otomatis nonaktif
# tapi API key statis di src/config/setting.js tetap jalan normal.
# Kalau pasang integrasi Upstash Redis dari Vercel Marketplace, 2 variabel ini
# (atau versi KV_REST_API_*) otomatis keisi sendiri, nggak perlu diisi manual.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
